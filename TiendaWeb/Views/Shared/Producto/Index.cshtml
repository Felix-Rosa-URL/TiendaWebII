@model List<TiendaWeb.Models.Producto>

<h2>Productos</h2>

<a asp-action="Crear" class="btn btn-primary">
Nuevo Producto
</a>

<table class="table">
<thead>
<tr>
<th>Nombre</th>
<th>Precio</th>
<th>Stock</th>
<th></th>
</tr>
</thead>

<tbody>
@foreach(var p in Model)
{
<tr>
<td>@p.Nombre</td>
<td>@p.Precio</td>
<td>@p.Stock</td>

<td>
<a asp-action="Detalle"
   asp-route-id="@p.Id">
Ver
</a>
</td>

</tr>
}
</tbody>
</table>